# ============================================================
# Backend .gitignore - Laravel (PHP)
# ============================================================

# ─── Environment & Secrets ─────────────────────────────────
.env
.env.*
!.env.example
auth.json
*.pem
*.key
/storage/*.key

# ─── Laravel Specific ──────────────────────────────────────
/vendor/
/node_modules/
/public/build/
/public/hot/
/public/storage/
/storage/pail/

# ─── Laravel Framework Cache & Generated Files ─────────────
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/testing/
/storage/framework/views/
/bootstrap/cache/*.php
!bootstrap/cache/.gitignore

# ─── Logs ──────────────────────────────────────────────────
/storage/logs/*.log
npm-debug.log
yarn-error.log

# ─── Testing ───────────────────────────────────────────────
/.phpunit.cache/
.phpunit.result.cache
/coverage/

# ─── IDE & Tools ───────────────────────────────────────────
/.idea/
/.vscode/
/.fleet/
/.nova/
/.zed/
.phpactor.json

# ─── Homestead / Vagrant ───────────────────────────────────
Homestead.json
Homestead.yaml
.vagrant/

# ─── OS Files ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
