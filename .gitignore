# ============================================================
# ROOT .gitignore - AtmaLibrary (Laravel Backend + React Frontend)
# ============================================================

# ─── OS & System Files ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDE & Editor Files ────────────────────────────────────
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sw?
*.sublime-project
*.sublime-workspace
.editorconfig.local

# ─── Environment & Secrets ─────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.cert
*.crt
auth.json
secrets.json

# ─── Logs ──────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Dependency Directories ────────────────────────────────
node_modules/
vendor/

# ─── Build & Compiled Outputs ──────────────────────────────
dist/
dist-ssr/
build/
out/
.output/
*.local

# ─── Testing & Coverage ────────────────────────────────────
coverage/
.coverage
*.coverage
.nyc_output/

# ─── Temporary Files ───────────────────────────────────────
tmp/
temp/
*.tmp
*.temp
*.cache

# ─── Package Manager Locks (optional - keep if you want reproducible installs) ─
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

