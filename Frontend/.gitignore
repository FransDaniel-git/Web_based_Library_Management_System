# ============================================================
# Frontend .gitignore - React + Vite
# ============================================================

# ─── Environment & Secrets ─────────────────────────────────
.env
.env.*
!.env.example
*.local

# ─── Dependencies ──────────────────────────────────────────
node_modules/

# ─── Build Outputs ─────────────────────────────────────────
dist/
dist-ssr/
build/
out/

# ─── Logs ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Testing & Coverage ────────────────────────────────────
coverage/
.nyc_output/

# ─── Cache ─────────────────────────────────────────────────
.cache/
.vite/
*.tsbuildinfo

# ─── IDE & Editor ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS Files ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
